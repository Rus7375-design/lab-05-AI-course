def my_agent(question, max_steps=8):
    """Run one question to the end. Return (the final reply text, the list of messages)."""
    messages = build_messages(question)
    for _ in range(max_steps):
        gen = llm.generate(messages)                                   # TODO 1
        messages.append({"role": "assistant", "content": gen.text})
        calls = parse_tool_calls(gen.text)                             # TODO 2
        if not calls:
            return gen.text, messages
        for call in calls:                                             # TODO 3
            result = toolbox.run(call.name, call.arguments)
            messages.append({"role": "tool", "content": result})
    return "", messages
